      execSync(`"${venvPython}" -c "import pydantic"`, {
        encoding: 'utf8',
        stdio: ['ignore', 'pipe', 'ignore'],
        timeout: 3000,
      });
      found = true;
      location = 'venv';
    } catch {
      // venv exists but packages not installed
    }
  }

  // Fallback to system Python (CI mode)
  if (!found) {
