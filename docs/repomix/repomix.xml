      execSync('python3 -c "import pydantic"', {
        encoding: 'utf8',
        stdio: ['ignore', 'pipe', 'ignore'],
        timeout: 3000,
      });
      found = true;
      location = isCI ? 'CI global' : 'system';
    } catch {
      // Not available
    }
  }

  if (found) {
