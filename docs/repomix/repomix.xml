            lines.append("│   └── index.test.ts")
        lines.append("├── package.json")
        lines.append("├── tsconfig.json")
        lines.append("└── README.md")
    else:
        lines.append("├── src/")
        lines.append("│   └── main.*")
        if info.has_tests:
            lines.append("├── tests/")
        lines.append("└── README.md")

    lines.append("```")

    return ReadmeSection(
        section_type="structure",
