{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 50000000
  },
  "output": {
    "filePath": "docs/repomix/repomix.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "removeComments": false,
    "removeEmptyLines": false,
    "truncateBase64": true,
    "fileSummary": false,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 20,
    "showLineNumbers": false,
    "copyToClipboard": false,
    "includeEmptyDirectories": false,
    "includeFullDirectoryStructure": true,
    "headerText": "ast-grep-mcp bundle generated by Repomix (XML output, lossless: no compression, comments and blank lines preserved). Python MCP server for structural code search and refactoring. Core runtime is src/ast_grep_mcp/ (~143k tokens): features/ is the bulk (~111k; heaviest: deduplication, search, quality, documentation, schema, cross_language), plus core/, models/, utils/, server/. scripts/ (~32k) holds analysis/benchmark tooling; rules/ and templates/ are small. tests/, docs/, and scripts/*_results.json are excluded to control token bloat. Git diffs/logs are disabled.",
    "instructionFilePath": "docs/repomix/repomix-instruction.md",
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 200,
      "includeDiffs": false,
      "includeLogs": false,
      "includeLogsCount": 1
    }
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "rules/**/*",
    "templates/**/*",
    ".github/**/*",
    "main.py",
    "analyze_codebase.py",
    "pyproject.toml",
    "README.md",
    "CLAUDE.md",
    "GEMINI.md",
    ".repomixignore"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/docs/**",
      "docs/**",
      "scripts/repomix/**",
      "**/scripts/repomix/**",
      "scripts/*_results.json",
      "scripts/all_tools_results.json",
      "**/.ast-grep-backups/**",
      ".ast-grep-backups/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/out/**",
      "**/.next/**",
      "**/.turbo/**",
      "**/.vite/**",
      "**/coverage/**",
      "**/*.log",
      "**/*.tmp",
      "**/*.temp",
      "**/*.cache",
      "**/*.swp",
      "**/*.swo",
      "**/*.tsbuildinfo",
      "**/*.map",
      "**/*.min.js",
      "**/*.min.css",
      "**/__snapshots__/**",
      "**/*.snap",
      "tests/**",
      "**/*.test.*",
      "**/*.spec.*",
      "**/fixtures/**",
      "**/test-files/**",
      "**/manual/**",
      "**/results/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.gif",
      "**/*.webp",
      "**/*.ico",
      "**/*.pdf",
      "**/*.zip",
      "**/*.tar",
      "**/*.gz",
      "**/*.tgz",
      "**/*.7z",
      "**/*.mp4",
      "**/*.mov",
      "**/*.avi",
      "**/*.mp3",
      "**/*.wav",
      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/*secret*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  },
  "tokenBudget": {
    "maxTokens": 200000
  }
}
